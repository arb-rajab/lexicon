# Production-shaped backend image (Session 7 — release readiness).
# Distinct from ../Dockerfile, which docker-compose.yml's dev stack
# builds: that image runs bare `uvicorn lexicon.main:app` with no worker
# process model, installs `.` (no extras) in one stage, and runs as root.
# This image adds a real production ASGI server (gunicorn managing
# multiple uvicorn worker processes, no --reload), a builder stage so the
# runtime image carries no build toolchain, and a non-root runtime user.
#
# Build context is still `backend/` (same as ../Dockerfile) —
# docker-compose.prod.yml invokes this as
# `docker build -f docker/Dockerfile.prod .` from inside `backend/`.

FROM python:3.12-slim AS builder

WORKDIR /build

COPY pyproject.toml ./
COPY src ./src

# `.[prod]` adds gunicorn only — `.[dev]`'s pytest/ruff/mypy/bandit
# toolchain has no place in a runtime image, and was never installed by
# ../Dockerfile either.
RUN pip install --no-cache-dir --prefix=/install '.[prod]'

FROM python:3.12-slim

RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin lexicon

WORKDIR /app

COPY --from=builder /install /usr/local
COPY src ./src
COPY alembic ./alembic
COPY alembic.ini ./
COPY docker/entrypoint.prod.sh ./docker/entrypoint.prod.sh

# Pre-warm the ingestion embedding model (BAAI/bge-small-en-v1.5 via
# fastembed/ONNX, ingestion/embeddings.py) into a fixed cache directory at
# *build* time, not left to download on a container's first real request.
# Found necessary, not just nice-to-have, this session: the first-ever
# request to hit embed_texts() previously triggered a live ~20-30s
# HuggingFace download from inside the request, which — combined with the
# blocking-event-loop bug fixed in api/documents.py the same session —
# tripped gunicorn's worker-timeout heartbeat. Baking the model in here
# removes that live network dependency from the request path entirely.
ENV EMBEDDING_CACHE_DIR=/app/.cache/fastembed
RUN mkdir -p "${EMBEDDING_CACHE_DIR}" \
    && python -c "from lexicon.ingestion.embeddings import _model; _model()"

RUN chown -R lexicon:lexicon /app
USER lexicon

EXPOSE 8000

ENV PYTHONUNBUFFERED=1 \
    WEB_CONCURRENCY=4 \
    GUNICORN_TIMEOUT=60 \
    LOG_LEVEL=info

# Same migrate-then-serve sequence ../Dockerfile already uses (alembic
# upgrade head via DATABASE_ADMIN_URL, then serve as the restricted
# DATABASE_URL role — ADR-0002) — only the serve half changes here.
CMD ["sh", "docker/entrypoint.prod.sh"]
