# Copy to .env and adjust as needed for local development.

# PostgreSQL — admin/owner role (runs migrations, per ADR-0002)
POSTGRES_USER=lexicon
POSTGRES_PASSWORD=lexicon
POSTGRES_DB=lexicon
DATABASE_ADMIN_URL=postgresql+psycopg://lexicon:lexicon@postgres:5432/lexicon

# PostgreSQL — restricted application runtime role (ADR-0002: INSERT/SELECT
# only on QUERY_LOG/RETRIEVED_CHUNK/CITATION_VERDICT; created by migration
# 0002, not by docker-compose itself)
APP_DB_ROLE=lexicon_app
APP_DB_PASSWORD=lexicon_app_dev_only
DATABASE_URL=postgresql+psycopg://lexicon_app:lexicon_app_dev_only@postgres:5432/lexicon

# Redis — also backs T-05's per-corpus query rate limit and daily spend
# ceiling (lexicon.api.rate_limit)
REDIS_URL=redis://redis:6379/0

# T-05 cost-abuse controls (06-security-threat-model.md) — conservative
# placeholders, not measured against real production traffic or provider
# pricing data. See config.py for what each one gates.
MAX_QUESTION_LENGTH=1000
QUERY_RATE_LIMIT_PER_MINUTE=20
QUERY_DAILY_SPEND_CEILING=500

# T-06 cost-abuse control — max accepted upload size in bytes (413 above
# this limit). Conservative placeholder.
MAX_UPLOAD_SIZE_BYTES=10485760

# ADR-0005 — real instance-level authentication. Signs/verifies this
# instance's session tokens (POST /api/v1/auth/register, /login). The value
# below is a labeled dev-only placeholder (see config.py) — every real
# deployment MUST override this with a long, random, environment-specific
# secret; anyone who has read this public repository can forge tokens
# signed with the default.
JWT_SECRET_KEY=lexicon-dev-only-jwt-secret-DO-NOT-USE-IN-PRODUCTION
# T-12 cost/abuse control — login attempts per username per 5-minute
# window before a 429. Conservative placeholder.
LOGIN_RATE_LIMIT_PER_5_MINUTES=10
# Registration attempts across the whole instance per 5-minute window
# before a 429 (global, not per-username — see
# lexicon.api.rate_limit.enforce_register_rate_limit for why). Conservative
# placeholder.
REGISTER_RATE_LIMIT_PER_5_MINUTES=20

# LLM provider (ADR-0001, ADR-0003) — leave empty to run against the
# labeled stub LLM client tier (lexicon.llm.stub_client.StubLLMClient).
# See docs/project-memory/12-session-handoff.md for what that does and does
# not prove. Set a real key to switch to lexicon.llm.anthropic_client.
# AnthropicLLMClient — no code change required.
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-sonnet-5
VERIFICATION_MODEL=claude-haiku-4-5

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=lexicon
MINIO_ROOT_PASSWORD=lexicon-dev-only
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=lexicon

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8010
# ADR-0005 — set to true only once this app is actually served over HTTPS
# (it isn't, in either compose stack today); see docker-compose.prod.yml's
# comment on the frontend service for why this must stay false until then.
COOKIE_SECURE=false

# Production stack only (docker-compose.prod.yml, Session 7) — unused by
# docker-compose.yml's dev stack. All optional; shown here with their
# built-in defaults for discoverability. See
# docs/project-memory/08-deployment-and-operations.md for what each does.
# LOG_LEVEL=info
# WEB_CONCURRENCY=4
# GUNICORN_TIMEOUT=60
